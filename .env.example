# Radar (demo): todas las variables, con valores falsos. Los valores reales van en .env.local (lo completa Germán).
# Ver qué falta sin mostrar valores: npm run check-env

# Google Cloud (console.cloud.google.com → APIs y servicios → Credenciales): una clave con Places API (New) y
# PageSpeed Insights API habilitadas. Configurar un presupuesto con alerta de USD 5 en Billing.
GOOGLE_API_KEY=pon-aca-tu-clave

# Gemini (aistudio.google.com → Get API key): borradores de abordaje (P5-G2).
GEMINI_API_KEY=pon-aca-tu-clave
GEMINI_MODEL=gemini-3.5-flash-lite

# Modo real de la web (Places, las webs y PageSpeed de verdad): NO se activa con una variable de acá. Se abre con
# `npm run dev:real`, que escucha solo en 127.0.0.1. Con `npm run dev`, `start` o en Vercel, la consola es la demo.

# HubSpot (opcional; app.hubspot.com → Development → Keys → Service Keys, permiso crm.objects.companies.write).
# Sin token, "Pasar a HubSpot" es una simulación que no manda nada.
HUBSPOT_TOKEN=
